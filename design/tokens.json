{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "TVSRide mobile companion design tokens. A practical, ride-first interface using neutral surfaces, a restrained blue accent, clear status colours and readable system typography.",
  "color": {
    "$type": "color",
    "primary": { "$value": { "colorSpace": "srgb", "components": [0, 0.322, 1], "hex": "#0052FF" } },
    "primary-active": { "$value": { "colorSpace": "srgb", "components": [0, 0.243, 0.8], "hex": "#003ECC" } },
    "canvas": { "$value": { "colorSpace": "srgb", "components": [1, 1, 1], "hex": "#FFFFFF" } },
    "canvas-dark": { "$value": { "colorSpace": "srgb", "components": [0.039, 0.043, 0.051], "hex": "#0A0B0D" } },
    "surface": { "$value": { "colorSpace": "srgb", "components": [0.969, 0.969, 0.969], "hex": "#F7F7F7" } },
    "surface-dark": { "$value": { "colorSpace": "srgb", "components": [0.086, 0.094, 0.11], "hex": "#16181C" } },
    "text": { "$value": { "colorSpace": "srgb", "components": [0.039, 0.043, 0.051], "hex": "#0A0B0D" } },
    "text-dark": { "$value": { "colorSpace": "srgb", "components": [1, 1, 1], "hex": "#FFFFFF" } },
    "muted": { "$value": { "colorSpace": "srgb", "components": [0.357, 0.38, 0.431], "hex": "#5B616E" } },
    "muted-dark": { "$value": { "colorSpace": "srgb", "components": [0.659, 0.675, 0.702], "hex": "#A8ACB3" } },
    "border": { "$value": { "colorSpace": "srgb", "components": [0.871, 0.882, 0.902], "hex": "#DEE1E6" } },
    "connected": { "$value": { "colorSpace": "srgb", "components": [0.02, 0.694, 0.412], "hex": "#05B169" } },
    "warning": { "$value": { "colorSpace": "srgb", "components": [0.957, 0.69, 0], "hex": "#F4B000" } },
    "error": { "$value": { "colorSpace": "srgb", "components": [0.812, 0.125, 0.184], "hex": "#CF202F" } }
  },
  "spacing": {
    "$type": "dimension",
    "xxs": { "$value": { "value": 4, "unit": "px" } },
    "xs": { "$value": { "value": 8, "unit": "px" } },
    "sm": { "$value": { "value": 12, "unit": "px" } },
    "base": { "$value": { "value": 16, "unit": "px" } },
    "md": { "$value": { "value": 20, "unit": "px" } },
    "lg": { "$value": { "value": 24, "unit": "px" } },
    "xl": { "$value": { "value": 32, "unit": "px" } }
  },
  "rounded": {
    "$type": "dimension",
    "sm": { "$value": { "value": 8, "unit": "px" } },
    "md": { "$value": { "value": 12, "unit": "px" } },
    "lg": { "$value": { "value": 16, "unit": "px" } },
    "xl": { "$value": { "value": 24, "unit": "px" } },
    "pill": { "$value": { "value": 100, "unit": "px" } }
  },
  "typography": {
    "screen-title": { "$type": "typography", "$value": { "fontFamily": "sans-serif", "fontSize": { "value": 30, "unit": "px" }, "fontWeight": 400 } },
    "section-title": { "$type": "typography", "$value": { "fontFamily": "sans-serif", "fontSize": { "value": 18, "unit": "px" }, "fontWeight": 600 } },
    "body": { "$type": "typography", "$value": { "fontFamily": "sans-serif", "fontSize": { "value": 16, "unit": "px" }, "fontWeight": 400 } },
    "supporting": { "$type": "typography", "$value": { "fontFamily": "sans-serif", "fontSize": { "value": 13, "unit": "px" }, "fontWeight": 400 } },
    "measurement": { "$type": "typography", "$value": { "fontFamily": "monospace", "fontSize": { "value": 20, "unit": "px" }, "fontWeight": 500 } },
    "speed": { "$type": "typography", "$value": { "fontFamily": "monospace", "fontSize": { "value": 58, "unit": "px" }, "fontWeight": 500 } }
  },
  "interaction": {
    "minimum-touch-target": { "$type": "dimension", "$value": { "value": 48, "unit": "px" } }
  }
}